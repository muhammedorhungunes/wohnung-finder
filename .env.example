# Database (Docker Postgres)
DATABASE_URL="postgresql://wohnung:wohnung@localhost:5432/wohnung_finder"

# Gmail (generate App Password at myaccount.google.com → Security → App Passwords)
GMAIL_USER=your@gmail.com
